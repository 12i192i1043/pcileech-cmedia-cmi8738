; C-Media CMI8738/PCI-SX (13F6:0111 rev 0x10) config space shadow
; Based on REAL hardware dump (Linux bus 2a:00.0, post-BIOS pre-driver state)
;   - PM cap @ 0xC0 (NOT 0x40 as common assumption!)
;   - NO MSI cap (legacy INTx only, as per chip spec)
;   - NO PCIe Express cap (it is PCI, not PCIe)
; CapPtr @ 0x34 = 0xC0 → single PM cap at end of standard cfgspace.
memory_initialization_radix=16;
memory_initialization_vector=

; 0x00-0x0F: VID=13F6 DID=0111, Cmd=0x0081 Sts=0x0210, Class=040100 Rev=10, Hdr=0
011113f6,02100081,04010010,00000000,
; 0x10-0x1F: BAR0 I/O @ 0xD000 (256B, bit0=1), BAR1-3 disabled
0000d001,00000000,00000000,00000000,
; 0x20-0x2F: BAR4-5 disabled, CardBus CIS=0, Subsys=13F6:0111
00000000,00000000,00000000,011113f6,
; 0x30-0x3F: ExpROM=0, CapPtr=0xC0, Reserved=0, IntLine=5 IntPin=INTA MinGnt=02 MaxLat=18
00000000,000000c0,00000000,18020105,
; 0x40-0x4F: empty (no caps here on real CMI8738)
00000000,00000000,00000000,00000000,
; 0x50-0x5F: empty
00000000,00000000,00000000,00000000,
; 0x60-0x6F: empty
00000000,00000000,00000000,00000000,
; 0x70-0x7F: empty
00000000,00000000,00000000,00000000,
; 0x80-0x8F: empty
00000000,00000000,00000000,00000000,
; 0x90-0x9F: empty
00000000,00000000,00000000,00000000,
; 0xA0-0xAF: empty
00000000,00000000,00000000,00000000,
; 0xB0-0xBF: empty
00000000,00000000,00000000,00000000,
; 0xC0-0xCF: PM Cap (ID=01 Next=00 PMC=0602: D1+D2 supported), PMCSR=0
06020001,00000000,00000000,00000000,
; 0xD0-0xDF: empty
00000000,00000000,00000000,00000000,
; 0xE0-0xEF: empty
00000000,00000000,00000000,00000000,
; 0xF0-0xFF: empty
